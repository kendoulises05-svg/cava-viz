<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Forma: grosor y hueco en px; la cantidad de barras se calcula sola -->
    <entry name="barWidth" type="Int"><default>4</default></entry>
    <entry name="barGap" type="Int"><default>3</default></entry>
    <!-- 0 = desde abajo, 1 = espejo, 2 = flotante -->
    <entry name="orientation" type="Int"><default>0</default></entry>
    <!-- Espejo: posición de la línea (0.5 = centro, 0.95 = casi abajo) -->
    <entry name="mirrorLine" type="Double"><default>0.8</default></entry>
    <entry name="mirrorOpacity" type="Double"><default>0.35</default></entry>
    <!-- 0 = accent + 2do color, 1 = por zona, 2 = contraste (brillo invertido), 3 = automático (experimental) -->
    <entry name="colorMode" type="Int"><default>0</default></entry>
    <entry name="colorBlend" type="Double"><default>0.85</default></entry>
    <!-- Por zona y automático: true = intercambia los colores entre zonas (zorro naranja -> barras azules) -->
    <entry name="zoneSwap" type="Bool"><default>false</default></entry>
    <entry name="showPeaks" type="Bool"><default>true</default></entry>
    <entry name="peakFall" type="Double"><default>0.8</default></entry>
    <entry name="hideOnSilence" type="Bool"><default>true</default></entry>
    <!-- Cuadros por segundo del visualizer (30, 45 o 60). Menos fps = menos CPU -->
    <entry name="fps" type="Int"><default>60</default></entry>
    <!-- Pausar cuando: 0 = nunca, 1 = solo pantalla completa, 2 = pantalla completa o maximizada,
         3 = una ventana tapa el widget (incluye tiling) -->
    <entry name="pauseRule" type="Int"><default>3</default></entry>
    <!-- Audio: 0 = stereo, 1 = mono -->
    <entry name="audioChannels" type="Int"><default>0</default></entry>
    <!-- 0 = normal (stereo: graves al centro, mono: graves a la izquierda), 1 = invertida -->
    <entry name="bassLayout" type="Int"><default>0</default></entry>
    <!-- Glow que pulsa con los graves -->
    <entry name="glowEnabled" type="Bool"><default>false</default></entry>
    <entry name="glowStrength" type="Double"><default>0.6</default></entry>
    <!-- 0 = mismo color que la barra, 1 = contraste con la barra (automático) -->
    <entry name="glowColorMode" type="Int"><default>1</default></entry>
    <!-- Rotación de wallpaper (la ejecuta el puente) -->
    <entry name="rotationEnabled" type="Bool"><default>true</default></entry>
    <!-- Vacío = carpeta de la presentación de Plasma -->
    <entry name="rotationDir" type="String"><default></default></entry>
    <!-- Segundos (54000 = 15 horas) -->
    <entry name="rotationIntervalSec" type="Int"><default>54000</default></entry>
    <!-- 0 = aleatorio, 1 = alfabético, 2 = más recientes primero -->
    <entry name="rotationOrder" type="Int"><default>0</default></entry>
  </group>
</kcfg>
